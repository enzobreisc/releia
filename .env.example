APP_NAME=releia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=





VITE_APP_NAME="${APP_NAME}"
NATIVEPHP_APP_ID=com.enzobreisc.releia
NATIVEPHP_APP_VERSION=0.10.0
NATIVEPHP_APP_AUTHOR=enzobreisc
NATIVEPHP_APP_DESCRIPTION="Personal reading catalog"
NATIVEPHP_APP_WEBSITE=https://github.com/enzobreisc/releia
NATIVEPHP_UPDATER_ENABLED=false

GOOGLE_BOOKS_API_KEY=
